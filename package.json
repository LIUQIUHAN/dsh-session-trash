{
  "name": "@dsh2030/session-trash",
  "version": "1.3.1",
  "description": "把「删除会话」变成可恢复操作：移入回收站、一键还原、彻底清除，支持对话预览与按天自动清理。",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node smoke-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2",
      "tested": [
        "0.2.2-rc.5"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "trash",
    "recycle-bin",
    "restore",
    "cleanup",
    "回收站",
    "会话",
    "恢复"
  ],
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/@dsh2030/session-trash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIUQIUHAN/dsh-session-trash.git"
  },
  "bugs": {
    "url": "https://github.com/LIUQIUHAN/dsh-session-trash/issues"
  }
}
